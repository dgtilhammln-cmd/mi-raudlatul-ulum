APP_NAME="Musabaqah Tarikh Islam"
APP_ENV=production
APP_KEY=base64:fneoowFN6gszGuItvHNykV24IzNtUQqnKkiDbIunEmg=
APP_DEBUG=false
APP_URL=https://DOMAIN_ANDA.COM

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

# ─── DATABASE (isi sesuai panel Hostinger) ───
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=NAMA_DB_HOSTINGER
DB_USERNAME=USERNAME_DB_HOSTINGER
DB_PASSWORD=PASSWORD_DB_HOSTINGER

# ─── CACHE & SESSION ───
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=database

# ─── MAIL (isi SMTP Hostinger / Gmail / Mailtrap) ───
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=EMAIL_ANDA@gmail.com
MAIL_PASSWORD=APP_PASSWORD_GMAIL
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=EMAIL_ANDA@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# ─── STORAGE ───
FILESYSTEM_DISK=local
